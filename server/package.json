{
  "name": "server",
  "version": "1.0.0",
  "description": "Placezy Modular REST API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec tsx src/server.ts",
    "seed": "tsx src/seed.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "placezy",
    "api",
    "express",
    "mongoose",
    "typescript"
  ],
  "author": "Placezy Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2"
  }
}
